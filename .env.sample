DEBUG=true
PORT=8080

MONGODB_URI=mongodb://admin:password@localhost:27017/cakradana?authSource=admin

JWT_SECRET=
JWT_DEFAULT_EXPIRE=4h

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SSL=true
EMAIL_USER=
EMAIL_PASS=

AZURE_VISION_ENDPOINT=
AZURE_PREDICTION_KEY=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_API_MODEL=microsoft/mai-ds-r1:free

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=cakradana
R2_PUBLIC_URL=https://cakradana-cdn.faizath.com/
# Language model provider. `openrouter` sends document text to a hosted
# endpoint; `self-hosted` keeps it inside the deployment perimeter. Which one
# is set is a decision about personal data, not about latency.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-r1-distill-qwen-7b
# Only for LLM_PROVIDER=self-hosted: an OpenAI-compatible endpoint such as
# vLLM, Ollama, or TGI.
LLM_BASE_URL=
LLM_API_KEY=

# Scoring service. Ingestion never blocks on it: when unset, donations are
# stored and their scores stay outstanding rather than the upload failing.
SCORING_SERVICE_URL=
SCORING_SERVICE_TOKEN=

# Whether this deployment may contact subjects to tell them a donation
# attributed to them has been flagged. Off unless set to exactly `true`.
# Notifying a real person is not reversible, and a backfill or a rescore of
# historical records would otherwise reach them. Candidates are queued and
# decided by a person either way regardless of this setting; only delivery
# depends on it.
NOTIFY_SUBJECTS=false
EMAIL_FROM=

# Public holidays excluded from working-day deadline arithmetic, as a
# comma-separated list of YYYY-MM-DD. The Indonesian calendar includes movable
# religious holidays and government-declared collective leave published year by
# year, so it is supplied rather than guessed. Absent, deadlines come out
# slightly tighter than the true obligation.
PUBLIC_HOLIDAYS=
