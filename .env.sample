# Returns internal error messages to clients. The sample previously shipped
# this on, so the documented default configuration leaked stack-level detail
# about the database and the file system to anyone who could trigger an error.
DEBUG=false
PORT=8080

# json log level: debug | info | warn | error
LOG_LEVEL=info

# How many donations a review team can process in a period. The queue is cut to
# it, and every precision-at-budget figure is computed against it, so a wrong
# value describes an operating point nobody works at.
REVIEW_BUDGET=50

# Role checks. On, because the frontend is a static export and enforces
# nothing: every restriction that matters holds here or nowhere.
#
# Turning this on without preparing for it locks out the review queue. Every
# account defaults to `recipient` — most people who register are subjects of the
# data rather than reviewers of it — so with enforcement on and no roles
# assigned, the queue, the case bundle, and the disposition routes are refused
# to everybody. Before a first deployment:
#
#   npm run role -- --list       what every account holds now
#   npm run role -- --email analyst@example.org --role ppatk_analyst --by you@example.org
#
# `--list` says outright when no account holds a reviewer role.
#
# Set to `false` to run in observe-only mode instead: a request that would have
# been refused is logged as such and allowed, which is how a deployment whose
# accounts predate the role field reads its own blast radius before committing.
ENFORCE_ROLES=true

# Retention deletion. On, because a retention period nothing enforces is not a
# retention period — it is a description of what the system would do, attached
# to records it is in fact keeping indefinitely, in a system holding political
# donations by named people.
#
# Deletion is irreversible, so read what it would take before the first run:
# with this set to `false` the schedule still runs as a dry run and logs every
# record it would have removed. The periods themselves are provisional pending
# legal review, and are stated in the retention module rather than here.
ENFORCE_RETENTION=true

# Building the published aggregate dataset. On, because transparency is what
# this system is for and a dataset nobody builds publishes nothing.
#
# Publication is one-way: a figure that has been served cannot be unserved, and
# for that reason a published cell is frozen rather than revised. The defences
# sit in the materialiser rather than in this switch — cells below five donors
# are published as suppressed with no figures at all, totals are rounded, and a
# quarter is not published until 90 days after it ends so that the frozen
# figures are likely to be the complete ones. The schema refuses any score,
# band, or flag field outright.
#
# Set to `false` on a deployment whose governance review has not concluded.
# Nothing is built and nothing is served while it is off.
PUBLISH_AGGREGATES=true

MONGODB_URI=mongodb://admin:password@localhost:27017/cakradana?authSource=admin

JWT_SECRET=
JWT_DEFAULT_EXPIRE=4h

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SSL=true
EMAIL_USER=
EMAIL_PASS=

OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_API_MODEL=microsoft/mai-ds-r1:free

# Language model provider. `openrouter` sends document text to a hosted
# endpoint; `self-hosted` keeps it inside the deployment perimeter. Which one
# is set is a decision about personal data, not about latency.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-r1-distill-qwen-7b
# Only for LLM_PROVIDER=self-hosted: an OpenAI-compatible endpoint such as
# vLLM, Ollama, or TGI.
LLM_BASE_URL=
LLM_API_KEY=

# Scoring service. Ingestion never blocks on it: when unset, donations are
# stored and their scores stay outstanding rather than the upload failing.
SCORING_SERVICE_URL=
SCORING_SERVICE_TOKEN=

# Whether this deployment may contact subjects to tell them a donation
# attributed to them has been flagged. Off unless set to exactly `true`.
# Notifying a real person is not reversible, and a backfill or a rescore of
# historical records would otherwise reach them. Candidates are queued and
# decided by a person either way regardless of this setting; only delivery
# depends on it.
NOTIFY_SUBJECTS=false
EMAIL_FROM=

# Public holidays excluded from working-day deadline arithmetic, as a
# comma-separated list of YYYY-MM-DD. The Indonesian calendar includes movable
# religious holidays and government-declared collective leave published year by
# year, so it is supplied rather than guessed. Absent, deadlines come out
# slightly tighter than the true obligation.
PUBLIC_HOLIDAYS=

# Strong identifiers — NIK, NPWP, passport numbers — are held in their own
# collection, encrypted, and reached through one service that records every
# read. Both secrets are required and there is no fallback: without them a
# value is refused rather than stored in the clear, because a failure to
# protect something must not present as having stored it safely.
#
# IDENTIFIER_KEY is 64 hex characters (a 256-bit AES key). IDENTIFIER_PEPPER
# keys the hash that lets two records be matched to one person without anybody
# reading a number — unkeyed would not do, since a NIK is sixteen digits
# encoding a region and a date of birth and its real space is small enough to
# enumerate.
#
# Absent, entity resolution rests on names alone, which is materially weaker.
# GET /service/identifiers/status reports which.
#   openssl rand -hex 32
IDENTIFIER_KEY=
IDENTIFIER_PEPPER=

# Whether a subject view may be scoped by an unverified name.
#
# A name is chosen at registration, registration issues a working token without
# verifying anything, and the uniqueness constraint then makes the claim
# permanent — so registering under a donor's name is enough to be shown their
# donations, and they can never register under their own name to contest it.
# What that discloses is somebody's politics, to a stranger, irreversibly.
#
# Off unless set to exactly `true`. A deployment whose accounts predate entity
# linking needs it while the links are established, and that is the only reason
# it exists. While on, every name-scoped read is logged as one.
ALLOW_NAME_SCOPED_SUBJECT_VIEWS=false
